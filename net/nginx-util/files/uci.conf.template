# Consider using UCI or creating files in /etc/nginx/conf.d/ for configuration.
# Parsing UCI configuration is skipped if uci set nginx.global.uci_enable=false
# For details see: https://openwrt.org/docs/guide-user/services/webserver/nginx

worker_processes auto;

user root;

events {}

http {
	access_log off;
	log_format openwrt
		'$request_method $scheme://$host$request_uri => $status'
		' (${body_bytes_sent}B in ${request_time}s) <- $http_referer';

	include mime.types;
	default_type application/octet-stream;
	sendfile on;

	client_max_body_size 128M;
	large_client_header_buffers 2 1k;

	gzip on;
	gzip_vary on;
	gzip_proxied any;

	root /www;

	include conf.d/*.conf;
}

rtmp {
	server {
		listen 1935;
		chunk_size 4096;
		application live {
			live on;
			meta off;
			record off;
			exec base -c "rm -rf /www/format.sdp";
			exec ffmpeg -i rtmp://localhost/live/livestream -vn -c:a copy -f rtp rtp://172.16.0.149:35002 -an -c:v copy -f rtp rtp://172.16.0.149:35000 -sdp_file /www/format.sdp;
			exec bash -c "sleep 4 && /app/transfer_client";
		}
	}
}
